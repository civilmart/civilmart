generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  VIEWER
  PURCHASE
  SALES
  STOREKEEPER
  MANAGER
  ADMIN
  SUPERADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

// Selling units for building materials (from the Civil Mart catalogue).
enum ProductUnit {
  BAG
  BOX
  CARTON
  PACK
  PIECE
  ROLL
  SHEET
  KG
  GRAM
  TON
  LITER
  CFT
  CUBIC_METER
  SFT
  METER
  FOOT
  GALLON
  SET
  PAIR
  TUBE
  CAN
  LENGTH
  SLAB
  DRUM
  KIT
  BUCKET
  ML
}

enum InventoryTransactionType {
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_BALANCE
  CORRECTION
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerOrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  email        String?  @unique
  phone        String?
  address      String?
  city         String?
  passwordHash String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  customer              Customer?

  @@map("users")
}

// ============================================================
// TRADES (top-level catalogue domain: Plumbing, Electrical, ...)
// ============================================================

model Trade {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]

  @@index([name])
  @@index([sortOrder])
  @@map("trades")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases          Purchase[]
  purchaseOrders     PurchaseOrder[]
  supplierProducts   SupplierProduct[]

  @@index([name])
  @@map("suppliers")
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  group       String?
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradeId String?

  products Product[]
  trade    Trade?    @relation(fields: [tradeId], references: [id])
  brands   Brand[]

  @@index([name])
  @@index([group])
  @@index([tradeId])
  @@map("categories")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String        @id @default(cuid())
  code        String        @unique
  barcode     String?       @unique
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)

  unit           ProductUnit
  stockQuantity  Decimal     @default(0) @db.Decimal(14, 4)

  subcategory   String?
  trades        String[]

  // Storefront fields
  imageUrl   String?
  imageUrl2  String?
  isFeatured Boolean  @default(false)

  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category              Category?             @relation(fields: [categoryId], references: [id])
  variants              ProductVariant[]
  customerOrderItems    CustomerOrderItem[]
  wishlistItems         CustomerWishlistItem[]
  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  invoiceItems          InvoiceItem[]
  supplierProducts      SupplierProduct[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

// ============================================================
// BRANDS (normalised list per category)
// ============================================================

model Brand {
  id         String   @id @default(cuid())
  name       String
  categoryId String?
  active     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category        Category?         @relation(fields: [categoryId], references: [id])
  supplierProducts SupplierProduct[]

  @@unique([name, categoryId])
  @@index([name])
  @@index([categoryId])
  @@map("brands")
}

// ============================================================
// SUPPLIER CATALOG / RATE LIST
// ============================================================

model SupplierProduct {
  id            String   @id @default(cuid())
  supplierId    String
  productId     String
  brandId       String?
  rateListPrice Decimal? @db.Decimal(14, 2)
  discount      Decimal  @default(0) @db.Decimal(5, 2)
  wholesalePrice Decimal? @db.Decimal(14, 2)
  retailPrice   Decimal? @db.Decimal(14, 2)
  notes         String?
  active        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variantPrices SupplierProductVariant[]

  @@unique([supplierId, productId])
  @@index([productId])
  @@index([brandId])
  @@map("supplier_products")
}

// ============================================================
// PRODUCT VARIANTS (optional pack sizes / SKU labels)
// ============================================================

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  barcode   String? @unique

  sku  String @unique
  name String

  // Examples: 50 kg, 1 Ton, 500 pcs, 25 m roll
  sizeValue Decimal     @db.Decimal(10, 2)
  sizeUnit  ProductUnit

  status ProductStatus @default(ACTIVE)

  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id])
  supplierPrices     SupplierProductVariant[]
  inventoryTransactions InventoryTransaction[]
  customerOrderItems CustomerOrderItem[]
  purchaseItems      PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]

  @@index([productId])
  @@map("product_variants")
}

// ============================================================
// SUPPLIER PRODUCT VARIANT PRICING (optional per-variant prices)
// ============================================================

model SupplierProductVariant {
  id               String  @id @default(cuid())
  supplierProductId String
  productVariantId  String

  rateListPrice   Decimal?  @db.Decimal(14, 2)
  discount        Decimal   @default(0) @db.Decimal(5, 2)
  wholesalePrice  Decimal?  @db.Decimal(14, 2)
  retailPrice     Decimal?  @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([supplierProductId, productVariantId])
  @@index([productVariantId])
  @@map("supplier_product_variants")
}

// ============================================================
// INVENTORY TRANSACTIONS (product ledger)
// ============================================================

model InventoryTransaction {
  id String @id @default(cuid())

  productId String
  variantId String?

  transactionType InventoryTransactionType

  // Quantity in the product's selling unit.
  quantity Decimal      @db.Decimal(14, 4)
  unit     ProductUnit

  referenceType String?
  referenceId   String?

  notes String?

  createdById String?
  createdAt   DateTime @default(now())

  product   Product           @relation(fields: [productId], references: [id])
  variant   ProductVariant?   @relation(fields: [variantId], references: [id])
  createdBy User?             @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ============================================================
// PURCHASES (goods received directly)
// ============================================================

model Purchase {
  id           String         @id @default(cuid())
  purchaseNo   String         @unique
  supplierId   String?
  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(DRAFT)
  subtotal     Decimal        @db.Decimal(14, 2)
  tax          Decimal        @default(0) @db.Decimal(14, 2)
  discount     Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal        @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id          String          @id @default(cuid())
  purchaseId  String
  productId   String
  variantId   String?
  quantity    Decimal         @db.Decimal(14, 4)
  unit        ProductUnit
  costPerUnit Decimal         @db.Decimal(14, 4)
  totalCost   Decimal         @db.Decimal(14, 2)
  notes       String?

  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_items")
}

// ============================================================
// PURCHASE ORDERS
// ============================================================

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String?
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([orderDate])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                   String            @id @default(cuid())
  purchaseOrderId      String
  productId            String
  variantId            String?
  quantity             Decimal           @db.Decimal(14, 4)
  receivedQuantity     Decimal           @default(0) @db.Decimal(14, 4)
  unit                 ProductUnit
  estimatedCostPerUnit Decimal?          @db.Decimal(14, 4)
  notes                String?

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id])
  variant       ProductVariant?  @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_order_items")
}

// ============================================================
// STORE CUSTOMERS
// ============================================================

model Customer {
  id           String   @id @default(cuid())
  userId       String?  @unique
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  name         String?
  address      String?
  city         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders   CustomerOrder[]
  wishlist CustomerWishlistItem[]
  invoices Invoice[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

// ============================================================
// STORE WISHLIST
// ============================================================

model CustomerWishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@map("customer_wishlist_items")
}

// ============================================================
// STORE ORDERS (COD)
// ============================================================

model CustomerOrder {
  id           String             @id @default(cuid())
  orderNumber  String             @unique
  customerId   String

  // Delivery / contact snapshot
  customerName  String
  phone         String
  email         String?
  address       String
  city          String?
  notes         String?

  paymentMethod String               @default("COD")
  status        CustomerOrderStatus  @default(PLACED)

  subtotal  Decimal @db.Decimal(14, 2)
  shipping  Decimal @db.Decimal(14, 2) @default(0)
  total     Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items        CustomerOrderItem[]
  statusEvents CustomerOrderStatusEvent[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id        String @id @default(cuid())
  orderId   String

  productId  String?
  variantId  String?

  sku         String
  productName String
  variantName String?
  imageUrl    String?

  quantity  Decimal     @default(1) @db.Decimal(14, 4)
  unit      ProductUnit
  unitPrice Decimal     @db.Decimal(14, 2)

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product  Product?        @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("customer_order_items")
}

model CustomerOrderStatusEvent {
  id      String @id @default(cuid())
  orderId String

  status CustomerOrderStatus
  note   String?
  at     DateTime @default(now())

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("customer_order_status_events")
}

// ============================================================
// INVOICES / BILLING
// ============================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNo     String        @unique
  customerId    String?
  orderId       String?
  createdById   String?

  invoiceDate DateTime   @default(now())
  dueDate     DateTime?
  subtotal    Decimal    @db.Decimal(14, 2)
  tax         Decimal    @default(0) @db.Decimal(14, 2)
  discount    Decimal    @default(0) @db.Decimal(14, 2)
  totalAmount Decimal    @db.Decimal(14, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    CustomerOrder? @relation(fields: [orderId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments InvoicePayment[]

  @@index([customerId])
  @@index([orderId])
  @@index([invoiceDate])
  @@index([paymentStatus])
  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  productId   String?
  variantId   String?

  description String
  sku         String?
  quantity    Decimal      @db.Decimal(14, 4)
  unit        ProductUnit
  unitPrice   Decimal      @db.Decimal(14, 4)
  totalPrice  Decimal      @db.Decimal(14, 2)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([variantId])
  @@map("invoice_items")
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  amount      Decimal  @db.Decimal(14, 2)
  method      String?
  reference   String?
  paidAt      DateTime @default(now())
  notes       String?
  createdById String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_payments")
}

// ============================================================
// SITE SETTINGS
// ============================================================

model SiteSetting {
  key       String @id
  value     String

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model AdPlacement {
  id        String   @id @default(cuid())
  slot      String
  title     String
  subtitle  String?
  imageUrl  String?
  href      String?
  contentType String  @default("IMAGE")
  embedCode   String?
  adSize      String  @default("FULL_WIDTH")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot, active, sortOrder])
  @@map("ad_placements")
}