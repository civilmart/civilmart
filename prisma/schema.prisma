generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  MANAGER
  STOREKEEPER
  PRODUCTION
  QC
  PURCHASE
  VIEWER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum UnitType {
  WEIGHT
  VOLUME
  PIECE
}

enum InventoryUnit {
  G
  KG
  ML
  L
  PIECE
}

enum FormulaStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WeightUnit {
  G
  KG
}

enum VolumeUnit {
  ML
  L
}

enum MaterialType {
  FRAGRANCE
  ESSENTIAL_OIL
  CHEMICAL
  ALCOHOL
  FIXATIVE
  COLOR
  PACKAGING
  OTHER
}

enum InventoryTransactionType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_BALANCE
  CORRECTION
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProductionBatchStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  email        String?  @unique
  passwordHash String?
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]

  @@map("users")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawMaterialLots RawMaterialLot[]
  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

// ============================================================
// RAW MATERIALS
// ============================================================

model RawMaterial {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  materialType MaterialType @default(OTHER)

  // The physical measurement category of this material.
  // Weight and volume are deliberately kept distinct.
  unitType UnitType

  // Density is optional and is only needed when converting
  // between weight and volume.
  density     Decimal? @db.Decimal(12, 6)
  densityUnit String?

  minimumStock Decimal? @db.Decimal(14, 4)
  reorderLevel Decimal? @db.Decimal(14, 4)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots                  RawMaterialLot[]
  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  formulaIngredients    FormulaIngredient[]
  materialConsumptions  MaterialConsumption[]

  @@index([name])
  @@index([materialType])
  @@map("raw_materials")
}

// ============================================================
// RAW MATERIAL LOTS
// ============================================================

model RawMaterialLot {
  id String @id @default(cuid())

  rawMaterialId String
  supplierId    String?

  lotNumber          String
  receivedAt         DateTime            @default(now())
  expiryDate         DateTime?
  formulaIngredients FormulaIngredient[]

  // Quantity received in the material's native unit.
  receivedQty Decimal @db.Decimal(14, 4)

  // Current balance is maintained through inventory transactions.
  // This field is intentionally NOT the source of truth.
  unitType UnitType
  unit     InventoryUnit

  costPerUnit Decimal? @db.Decimal(14, 4)
  totalCost   Decimal? @db.Decimal(14, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])

  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  materialConsumptions  MaterialConsumption[]

  @@unique([rawMaterialId, lotNumber])
  @@index([lotNumber])
  @@index([rawMaterialId])
  @@map("raw_material_lots")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants          ProductVariant[]
  formulas          Formula[]
  productionBatches ProductionBatch[]

  @@index([name])
  @@map("products")
}

// ============================================================
// PRODUCT VARIANTS / SKUs
// ============================================================

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  sku  String @unique
  name String

  // Examples: 30ml, 50ml, 100ml
  sizeValue Decimal    @db.Decimal(10, 2)
  sizeUnit  VolumeUnit

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product           Product           @relation(fields: [productId], references: [id])
  productionBatches ProductionBatch[]

  @@index([productId])
  @@map("product_variants")
}

// ============================================================
// FORMULAS
// ============================================================

model Formula {
  id          String        @id @default(cuid())
  productId   String
  code        String        @unique
  name        String
  description String?
  status      FormulaStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product           Product           @relation(fields: [productId], references: [id])
  versions          FormulaVersion[]
  productionBatches ProductionBatch[]

  @@index([productId])
  @@index([status])
  @@map("formulas")
}

model FormulaVersion {
  id        String        @id @default(cuid())
  formulaId String
  version   Int
  status    FormulaStatus @default(DRAFT)
  notes     String?
  batchSize Decimal      @db.Decimal(14, 4)
  batchUnit InventoryUnit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formula           Formula             @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  ingredients       FormulaIngredient[]
  productionBatches ProductionBatch[]

  @@unique([formulaId, version])
  @@index([formulaId])
  @@index([status])
  @@map("formula_versions")
}

model FormulaIngredient {
  id               String @id @default(cuid())
  formulaVersionId String
  rawMaterialId    String

  quantity Decimal       @db.Decimal(14, 4)
  unitType UnitType
  unit     InventoryUnit

  percentage Decimal? @db.Decimal(7, 4)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formulaVersion   FormulaVersion  @relation(fields: [formulaVersionId], references: [id], onDelete: Cascade)
  rawMaterial      RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  rawMaterialLot   RawMaterialLot? @relation(fields: [rawMaterialLotId], references: [id])
  rawMaterialLotId String?

  @@index([formulaVersionId])
  @@index([rawMaterialId])
  @@map("formula_ingredients")
}

// ============================================================
// INVENTORY TRANSACTIONS
// ============================================================

model InventoryTransaction {
  id String @id @default(cuid())

  rawMaterialId String?
  lotId         String?

  transactionType InventoryTransactionType

  // Quantity in the raw material's native unit.
  quantity Decimal       @db.Decimal(14, 4)
  unitType UnitType
  unit     InventoryUnit

  referenceType String?
  referenceId   String?

  notes String?

  createdById String?
  createdAt   DateTime @default(now())

  rawMaterial RawMaterial?    @relation(fields: [rawMaterialId], references: [id])
  lot         RawMaterialLot? @relation(fields: [lotId], references: [id])
  createdBy   User?           @relation(fields: [createdById], references: [id])

  @@index([rawMaterialId])
  @@index([lotId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Purchase {
  id           String         @id @default(cuid())
  purchaseNo   String         @unique
  supplierId   String?
  purchaseDate DateTime       @default(now())
  status       PurchaseStatus @default(DRAFT)
  subtotal     Decimal        @db.Decimal(14, 2)
  tax          Decimal        @default(0) @db.Decimal(14, 2)
  discount     Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal        @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
}

model PurchaseItem {
  id            String        @id @default(cuid())
  purchaseId    String
  rawMaterialId String
  lotId         String?
  quantity      Decimal       @db.Decimal(14, 4)
  unitType      UnitType
  unit          InventoryUnit
  costPerUnit   Decimal       @db.Decimal(14, 4)
  totalCost     Decimal       @db.Decimal(14, 2)
  notes         String?

  purchase    Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  lot         RawMaterialLot? @relation(fields: [lotId], references: [id])

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@index([lotId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String?
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([orderDate])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                   String        @id @default(cuid())
  purchaseOrderId      String
  rawMaterialId        String
  quantity             Decimal       @db.Decimal(14, 4)
  receivedQuantity     Decimal       @default(0) @db.Decimal(14, 4)
  unitType             UnitType
  unit                 InventoryUnit
  estimatedCostPerUnit Decimal?      @db.Decimal(14, 4)
  notes                String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@index([purchaseOrderId])
  @@index([rawMaterialId])
  @@map("purchase_order_items")
}

model ProductionBatch {
  id               String  @id @default(cuid())
  batchNumber      String  @unique
  productId        String
  productVariantId String?
  formulaId        String
  formulaVersionId String

  plannedQuantity  Decimal  @db.Decimal(14, 4)
  producedQuantity Decimal? @db.Decimal(14, 4)

  status ProductionBatchStatus @default(DRAFT)

  plannedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  formula        Formula         @relation(fields: [formulaId], references: [id])
  formulaVersion FormulaVersion  @relation(fields: [formulaVersionId], references: [id])

  materialConsumptions MaterialConsumption[]

  @@index([productId])
  @@index([formulaId])
  @@index([formulaVersionId])
  @@index([status])
  @@index([createdAt])
  @@map("production_batches")
}

model MaterialConsumption {
  id                String  @id @default(cuid())
  productionBatchId String
  rawMaterialId     String
  lotId             String?

  quantity Decimal       @db.Decimal(14, 4)
  unitType UnitType
  unit     InventoryUnit

  notes     String?
  createdAt DateTime @default(now())

  productionBatch ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  lot             RawMaterialLot? @relation(fields: [lotId], references: [id])

  @@index([productionBatchId])
  @@index([rawMaterialId])
  @@index([lotId])
  @@map("material_consumptions")
}
